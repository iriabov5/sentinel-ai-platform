# Sentinel AI Platform local configuration example.
# Copy values into your local shell or a private .env file if your tooling loads it.
# Do not commit real .env files or secrets.

# Micronaut environment selection for local runtime.
MICRONAUT_ENVIRONMENTS=local

# event-ingestion-service local HTTP port.
EVENT_INGESTION_SERVICE_PORT=8081

# event-ingestion-service metadata validation limits.
EVENT_INGESTION_METADATA_MAX_ENTRIES=25
EVENT_INGESTION_METADATA_MAX_KEY_LENGTH=64
EVENT_INGESTION_METADATA_MAX_VALUE_LENGTH=512

# Engineering quality tooling. Local fallback in Gradle is http://localhost:9000.
SONAR_HOST_URL=http://localhost:9000

# Keep tokens outside repository. Export this in your shell or CI secret store.
# SONAR_TOKEN=
